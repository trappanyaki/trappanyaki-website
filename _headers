# Netlify reads this straight from a drag-and-drop deploy.
# Inert on other hosts, which costs nothing but does not travel either.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-stable images. Without this a repeat visitor refetches ~700 KB.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Menu and price edits must show up immediately, never pinned by a stale cache.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate
